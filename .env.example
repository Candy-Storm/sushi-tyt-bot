# Скопіюйте цей файл у .env і впишіть свої значення.

# Токен бота від @BotFather (команда /newbot)
TOKEN=123456789:AAExampleTokenFromBotFather

# Telegram ID касирів/операторів через кому. Це початкове заповнення: далі касирів і власників
# можна додавати й видаляти в самому боті (кнопка «👥 Команда»). Видалені там люди з .env не повертаються.
# Свій ID можна дізнатися в боті @userinfobot
ADMIN_IDS=111111111,222222222

# Telegram ID власника (кількох власників пишіть через кому).
# Лише вони бачать кнопки власника (розсилка, призи, статистика, клієнти, команда, резервна копія). Власник автоматично отримує й доступ до панелі касира.
OWNER_IDS=111111111

# Необов'язково: файл бази даних (створиться автоматично)
DB_PATH=sushi_bot.db

# Необов'язково: папка для резервних копій бази (щоденних і за кнопкою)
BACKUP_DIR=backups

# Необов'язково: часовий пояс, за яким рахується «календарний день» рулетки
TIMEZONE=Europe/Kyiv
